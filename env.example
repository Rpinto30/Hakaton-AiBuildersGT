# Copia este archivo a .env y cambia la contraseña. .env NO se commitea.
POSTGRES_DB=educacion
POSTGRES_USER=educacion
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Usada por scripts/load_csv.py y por la API.
# 127.0.0.1 y NO localhost: el contenedor publica el puerto solo en IPv4, y
# resolver localhost intenta primero ::1, que agota timeouts (130 s vs 0.013 s).
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}

# Orígenes del frontend permitidos por CORS (separados por coma).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Agente del chat. Crea la llave en https://platform.openai.com/api-keys y ponla
# SOLO en .env. Sin llave el chat sigue funcionando con el buscador determinista
# (la respuesta trae con_ia = false).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Esfuerzo de razonamiento: low responde en ~5 s. Vacío si el modelo no lo acepta.
OPENAI_REASONING_EFFORT=low
