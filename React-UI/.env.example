# Copia este archivo a .env (NO se commitea). Variables del frontend.
#
# Endpoint del chatbot (GrokBot/API). Si se deja vacío, el chat responde
# localmente con los datos cargados en resources/. Contrato esperado:
#   POST {endpoint} con  { pregunta, contexto }
#   -> 200  { respuesta }
VITE_CHAT_ENDPOINT=

# Tiles base del mapa (intercambiables). Si se dejan vacíos se usan los de CARTO.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=