# Copia este archivo a .env y cambia la contraseña. .env NO se commitea.
POSTGRES_DB=educacion
POSTGRES_USER=educacion
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Usada por scripts/load_csv.py (usa una contraseña sin caracteres especiales de URL).
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# Orígenes del frontend permitidos por CORS (separados por coma).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
